  align-items: center;
}

.scene-builder__main {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.scene-builder__video-section {
  flex: 2;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.scene-builder__editor-section {
  flex: 1;
  padding: 2rem;
  border-left: 1px solid #333;
  background: #222;
}

.scene-builder__timeline {
  height: 150px;
  border-top: 1px solid #333;
  overflow-x: auto;
  background: #1a1a1a;
}

/* Video Canvas */
.video-canvas {
  position: relative;
  background: #000;
  border-radius: 8px;
  overflow: hidden;
}

.video-canvas__player {
  width: 100%;
  height: auto;
  max-height: 60vh;
}

.video-canvas--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  color: #666;
}

/* Remix History Stack */
.remix-history-stack {
  margin-top: 1rem;
}

.remix-history-stack__versions {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
  flex-direction: column;  /* Vertical stack */
}

.remix-version {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem;
  background: #2a2a2a;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.2s;
}

.remix-version:hover {
  background: #333;
}

.remix-version--active {
  background: #444;
  border: 2px solid #0066ff;
}

.remix-version__thumbnail {
  width: 80px;
  height: 45px;
  object-fit: cover;
  border-radius: 4px;
}

.remix-version__label {
  font-size: 0.875rem;
  color: #ccc;
}

/* Prompt Editor */
.prompt-editor {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.prompt-editor__textarea {
  width: 100%;
  padding: 1rem;
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 4px;
  color: #fff;
  font-family: inherit;
  font-size: 1rem;
  resize: vertical;
}

.prompt-editor__remix-btn {
  padding: 0.75rem 1.5rem;
  background: #0066ff;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.2s;
}

.prompt-editor__remix-btn:hover:not(:disabled) {
  background: #0052cc;
}

.prompt-editor__remix-btn:disabled {
  background: #333;
  cursor: not-allowed;
  color: #666;
}

.prompt-editor__hint {
  font-size: 0.875rem;
  color: #0066ff;
  margin: 0;
}

/* Timeline View */
.timeline-view {
  position: relative;
  height: 100%;
  padding: 1rem;
  display: flex;
  align-items: center;
}

.timeline-view__track {
  display: flex;
  gap: 4px;
  height: 100px;
}

.timeline-thumbnail {
  position: relative;
