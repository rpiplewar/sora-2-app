sora_2_api_constraints:
  video_expiration:
    documented: 24 hours from creation
    user_report: May be 1 hour now (unconfirmed)
    recommendation: Implement both checks with warnings

  remix_api:
    endpoint: POST /v1/videos/{video_id}/remix
    time_limit: Can only remix unexpired videos
    parameters:
      video_id: string (source video ID)
      prompt: string (modification instructions)
      model: "sora-2" | "sora-2-pro"
      size: string (e.g., "1280x720")
      seconds: string (MUST be string: "4", "8", "12")

  extend_pattern:
    no_dedicated_api: Use image-to-video with input_reference
    implementation: Extract last frame → pass as input_reference
    advantage: No time limits (works after expiration)

  no_scene_metadata:
    limitation: API does NOT return timestamps or scene info
    implication: Must track scenes manually in application state
