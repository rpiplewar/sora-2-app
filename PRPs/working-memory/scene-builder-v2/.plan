**Task 2.3**: Update remix service for auto-remix

Create `src/services/remixService.ts` (new file, not the old one):

```typescript
import { openaiService } from './openaiService';

export const remixService = {
  /**
   * Automatically remix video when prompt changes
   * No need for separate delta analysis - just use new prompt directly
   */
  async autoRemix(
    openaiVideoId: string,
    newPrompt: string,
    parameters: {
      model: string;
      size: string;
      seconds: string;
    },
    apiKey: string
  ): Promise<VideoJob> {
    // Call OpenAI remix API directly
    const response = await fetch('/api/proxy-remix-video', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        apiKey,
        videoId: openaiVideoId,
        prompt: newPrompt,
        ...parameters
      })
    });

    if (!response.ok) {
      throw new Error(`Remix failed: ${response.statusText}`);
    }

    const job = await response.json();

    // Poll until complete
    return await openaiService.pollUntilComplete(job.id, apiKey);
  }
};
```

**Task 2.4**: Create remix API proxy endpoint

Create `api/proxy-remix-video.ts`:

```typescript
export const config = { runtime: 'edge' };

export default async function handler(req: Request) {
  if (req.method !== 'POST') {
    return new Response('Method not allowed', { status: 405 });
  }

  try {
    const { apiKey, videoId, prompt, model, size, seconds } = await req.json();

    const response = await fetch(
      `https://api.openai.com/v1/videos/${videoId}/remix`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          prompt,
          model,
          size,
          seconds,
        }),
      }
    );

    if (!response.ok) {
      const error = await response.text();
      return new Response(error, { status: response.status });
    }

    const job = await response.json();
    return Response.json(job);
  } catch (error) {
    console.error('Remix proxy error:', error);
    return Response.json(
      { error: 'Failed to remix video' },
      { status: 500 }
    );
  }
}
```

### Phase 3: State Management (2-3 hours)

**Task 3.1**: Create SceneBuilder Zustand store

Create `src/stores/sceneBuilderStore.ts`:

```typescript
import { create } from 'zustand';
import { cloudStorageService } from '../services/cloudStorageService';
import { remixService } from '../services/remixService';
import { openaiService } from '../services/openaiService';
import { extractLastFrame } from '../utils/videoFrameExtractor';

interface RemixVersion {
  id: string;
  prompt: string;
  openaiVideoId: string;
  videoLocalId: string;  // From database
  videoBlob: Blob | null;  // Lazy-loaded
  thumbnailUrl: string | null;
  createdAt: number;
  isLoading: boolean;
}

interface Scene {
  id: string;
  versions: RemixVersion[];  // Stack: [Original, Remix v1, Remix v2, ...]
  currentVersionIndex: number;  // Points to active version
  prompt: string;  // Editable prompt for next remix
  isLocked: boolean;  // True after "Approve & Extend"
  parameters: {
    model: string;
    size: string;
    seconds: string;
  };
}

interface SceneBuilderState {
  scenes: Scene[];
  currentSceneId: string | null;
  isGenerating: boolean;
  isRemixing: boolean;
  isExtending: boolean;
  plannerEnabled: boolean;
  error: string | null;

  // Actions
  loadUserScenes: () => Promise<void>;
  createNewScene: (prompt: string, parameters: Scene['parameters']) => Promise<void>;
  remixCurrentVersion: () => Promise<void>;
  selectVersion: (sceneId: string, versionIndex: number) => void;
  extendScene: (newPrompt: string) => Promise<void>;
  updatePrompt: (sceneId: string, prompt: string) => void;
  togglePlanner: () => void;
  loadVideoBlob: (versionId: string) => Promise<void>;
}

export const useSceneBuilderStore = create<SceneBuilderState>((set, get) => ({
  scenes: [],
  currentSceneId: null,
  isGenerating: false,
  isRemixing: false,
  isExtending: false,
  plannerEnabled: false,
  error: null,

  loadUserScenes: async () => {
    try {
      const scenesFromDB = await cloudStorageService.listScenes();

      // Group by scene_id and create version stacks
      const sceneMap = new Map<string, Scene>();

      for (const video of scenesFromDB) {
        if (!sceneMap.has(video.sceneId)) {
          sceneMap.set(video.sceneId, {
            id: video.sceneId,
            versions: [],
            currentVersionIndex: 0,
            prompt: video.prompt,
            isLocked: false,
            parameters: video.parameters
          });
        }

        const scene = sceneMap.get(video.sceneId)!;
        scene.versions.push({
          id: video.localId,
          prompt: video.prompt,
          openaiVideoId: video.openaiVideoId,
          videoLocalId: video.localId,
          videoBlob: null,  // Lazy-load on demand
          thumbnailUrl: video.thumbnailUrl,
          createdAt: video.createdAt,
          isLoading: false
        });
      }

      set({ scenes: Array.from(sceneMap.values()) });
    } catch (error) {
      set({ error: 'Failed to load scenes' });
    }
  },

  createNewScene: async (prompt: string, parameters: Scene['parameters']) => {
    set({ isGenerating: true, error: null });

    try {
      const apiKey = storageService.getApiKey();
      if (!apiKey) throw new Error('API key required');

      // Generate video
      const job = await openaiService.createVideo({
        apiKey,
        prompt,
        ...parameters
      });

      const completedJob = await openaiService.pollUntilComplete(job.id, apiKey);
      const videoBlob = await openaiService.downloadVideo(completedJob.id, apiKey);

      // Upload to cloud storage
      const result = await cloudStorageService.uploadVideo(videoBlob, {
        openaiVideoId: completedJob.id,
        prompt,
        seconds: parseInt(parameters.seconds),
        size: parameters.size,
        model: parameters.model
      });

      // Create new scene in state
      const newScene: Scene = {
        id: crypto.randomUUID(),
        versions: [{
          id: result.localId,
          prompt,
          openaiVideoId: completedJob.id,
          videoLocalId: result.localId,
          videoBlob,
          thumbnailUrl: null,  // Generated during upload
          createdAt: Date.now(),
          isLoading: false
        }],
        currentVersionIndex: 0,
        prompt,
        isLocked: false,
        parameters
      };

      set(state => ({
        scenes: [...state.scenes, newScene],
        currentSceneId: newScene.id,
        isGenerating: false
      }));
    } catch (error) {
      set({ error: 'Failed to create scene', isGenerating: false });
    }
  },

  remixCurrentVersion: async () => {
    const { currentSceneId, scenes } = get();
    const scene = scenes.find(s => s.id === currentSceneId);
    if (!scene) return;

    set({ isRemixing: true, error: null });

    try {
      const apiKey = storageService.getApiKey();
      if (!apiKey) throw new Error('API key required');

      const currentVersion = scene.versions[scene.currentVersionIndex];
      const newPrompt = scene.prompt;

      // Call remix API
      const job = await remixService.autoRemix(
        currentVersion.openaiVideoId,
        newPrompt,
        scene.parameters,
        apiKey
      );

      const videoBlob = await openaiService.downloadVideo(job.id, apiKey);

      // Upload remixed video
      const result = await cloudStorageService.uploadVideo(videoBlob, {
        openaiVideoId: job.id,
        prompt: newPrompt,
        seconds: parseInt(scene.parameters.seconds),
        size: scene.parameters.size,
        model: scene.parameters.model,
        remixedFrom: currentVersion.videoLocalId
      });

      // Add new version to stack
      set(state => ({
        scenes: state.scenes.map(s =>
          s.id === currentSceneId
            ? {
                ...s,
                versions: [
                  ...s.versions,
                  {
                    id: result.localId,
                    prompt: newPrompt,
                    openaiVideoId: job.id,
                    videoLocalId: result.localId,
                    videoBlob,
                    thumbnailUrl: null,
                    createdAt: Date.now(),
                    isLoading: false
                  }
                ],
                currentVersionIndex: s.versions.length  // Point to new version
              }
            : s
        ),
        isRemixing: false
      }));
    } catch (error) {
      set({ error: 'Failed to remix', isRemixing: false });
    }
  },

  selectVersion: (sceneId: string, versionIndex: number) => {
    set(state => ({
      scenes: state.scenes.map(s =>
        s.id === sceneId
          ? { ...s, currentVersionIndex: versionIndex }
          : s
      )
    }));
  },

  extendScene: async (newPrompt: string) => {
    // Implementation: Extract last frame, create new scene with frame continuity
    // Similar to existing implementation in videoStore.ts
  },

  updatePrompt: (sceneId: string, prompt: string) => {
    set(state => ({
      scenes: state.scenes.map(s =>
        s.id === sceneId ? { ...s, prompt } : s
      )
    }));
  },

  togglePlanner: () => {
    set(state => ({ plannerEnabled: !state.plannerEnabled }));
  },

  loadVideoBlob: async (versionId: string) => {
    // Lazy-load video blob from GCS
    const blob = await cloudStorageService.loadVideo(versionId);

    set(state => ({
      scenes: state.scenes.map(scene => ({
        ...scene,
        versions: scene.versions.map(v =>
          v.id === versionId ? { ...v, videoBlob: blob, isLoading: false } : v
        )
      }))
    }));
  }
}));
```

**Validation**: Test store actions in React DevTools.

### Phase 4: UI Components (8-10 hours)

**Task 4.1**: Create main SceneBuilder page

Create `src/pages/SceneBuilder.tsx`:

```typescript
import React, { useEffect } from 'react';
import { useSceneBuilderStore } from '../stores/sceneBuilderStore';
import { VideoCanvas } from '../components/scene-builder/VideoCanvas';
import { RemixHistoryStack } from '../components/scene-builder/RemixHistoryStack';
import { PromptEditor } from '../components/scene-builder/PromptEditor';
import { TimelineView } from '../components/scene-builder/TimelineView';
import { PlannerToggle } from '../components/scene-builder/PlannerToggle';

export const SceneBuilder: React.FC = () => {
  const loadUserScenes = useSceneBuilderStore(state => state.loadUserScenes);

  useEffect(() => {
    loadUserScenes();
  }, []);

  return (
    <div className="scene-builder">
      <div className="scene-builder__header">
        <h1>Scene Builder</h1>
        <PlannerToggle />
      </div>

      <div className="scene-builder__main">
        <div className="scene-builder__video-section">
          <VideoCanvas />
          <RemixHistoryStack />
        </div>

        <div className="scene-builder__editor-section">
          <PromptEditor />
        </div>
      </div>

      <div className="scene-builder__timeline">
        <TimelineView />
      </div>
    </div>
  );
};
```

**Task 4.2**: Create VideoCanvas component

Create `src/components/scene-builder/VideoCanvas.tsx`:

```typescript
import React, { useRef, useEffect } from 'react';
import { useSceneBuilderStore } from '../../stores/sceneBuilderStore';

export const VideoCanvas: React.FC = () => {
  const videoRef = useRef<HTMLVideoElement>(null);
  const { currentSceneId, scenes, loadVideoBlob } = useSceneBuilderStore();

  const currentScene = scenes.find(s => s.id === currentSceneId);
  const currentVersion = currentScene?.versions[currentScene.currentVersionIndex];

  useEffect(() => {
    if (currentVersion && !currentVersion.videoBlob && !currentVersion.isLoading) {
      loadVideoBlob(currentVersion.id);
    }
  }, [currentVersion?.id]);

  useEffect(() => {
    if (videoRef.current && currentVersion?.videoBlob) {
      const url = URL.createObjectURL(currentVersion.videoBlob);
      videoRef.current.src = url;
      return () => URL.revokeObjectURL(url);
    }
  }, [currentVersion?.videoBlob]);

  if (!currentVersion) {
    return (
      <div className="video-canvas video-canvas--empty">
        <p>No scene selected. Create a new scene to get started.</p>
      </div>
    );
  }

  return (
    <div className="video-canvas">
      <video
        ref={videoRef}
        controls
        className="video-canvas__player"
      />
      {currentVersion.isLoading && (
        <div className="video-canvas__loader">Loading video...</div>
      )}
    </div>
  );
};
```

**Task 4.3**: Create RemixHistoryStack component

Create `src/components/scene-builder/RemixHistoryStack.tsx`:

```typescript
import React from 'react';
import { useSceneBuilderStore } from '../../stores/sceneBuilderStore';

export const RemixHistoryStack: React.FC = () => {
  const { currentSceneId, scenes, selectVersion } = useSceneBuilderStore();

  const currentScene = scenes.find(s => s.id === currentSceneId);
  if (!currentScene || currentScene.versions.length <= 1) return null;

  return (
    <div className="remix-history-stack">
      <h3>Remix History</h3>
      <div className="remix-history-stack__versions">
        {currentScene.versions.map((version, index) => (
          <div
            key={version.id}
            className={`remix-version ${
              index === currentScene.currentVersionIndex ? 'remix-version--active' : ''
            }`}
            onClick={() => selectVersion(currentSceneId!, index)}
          >
            <img
              src={version.thumbnailUrl || '/placeholder.png'}
              alt={`Version ${index + 1}`}
              className="remix-version__thumbnail"
            />
            <div className="remix-version__label">
              {index === 0 ? 'Original' : `Remix v${index}`}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};
```

**Task 4.4**: Create PromptEditor component

Create `src/components/scene-builder/PromptEditor.tsx`:

```typescript
import React from 'react';
import { useSceneBuilderStore } from '../../stores/sceneBuilderStore';

export const PromptEditor: React.FC = () => {
  const {
    currentSceneId,
    scenes,
    updatePrompt,
    remixCurrentVersion,
    isRemixing
  } = useSceneBuilderStore();

  const currentScene = scenes.find(s => s.id === currentSceneId);

  if (!currentScene) {
    return <div className="prompt-editor prompt-editor--empty">No scene selected</div>;
  }

  const handlePromptChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
    updatePrompt(currentSceneId!, e.target.value);
  };

  const handleRemix = () => {
    if (currentScene.prompt.trim()) {
      remixCurrentVersion();
    }
  };

  const hasChanges = currentScene.prompt !== currentScene.versions[currentScene.currentVersionIndex].prompt;

  return (
    <div className="prompt-editor">
      <h3>Edit Prompt</h3>
      <textarea
        className="prompt-editor__textarea"
        value={currentScene.prompt}
        onChange={handlePromptChange}
        placeholder="Describe your video scene..."
        rows={6}
      />

      <button
        className="prompt-editor__remix-btn"
        onClick={handleRemix}
        disabled={!hasChanges || isRemixing || currentScene.isLocked}
      >
        {isRemixing ? 'Remixing...' : 'Remix with New Prompt'}
      </button>

      {hasChanges && (
        <p className="prompt-editor__hint">
          Changes detected. Click "Remix" to generate new version.
        </p>
      )}
    </div>
  );
};
```

**Task 4.5**: Create TimelineView component

Create `src/components/scene-builder/TimelineView.tsx`:

```typescript
import React, { useState, useEffect } from 'react';
import { useSceneBuilderStore } from '../../stores/sceneBuilderStore';
import { TimelineThumbnail } from './TimelineThumbnail';
import { SegmentThumbnailGenerator } from '../../utils/videoThumbnailGenerator';

export const TimelineView: React.FC = () => {
  const { currentSceneId, scenes } = useSceneBuilderStore();
  const [thumbnails, setThumbnails] = useState<ThumbnailData[]>([]);
  const [currentTime, setCurrentTime] = useState(0);

  const currentScene = scenes.find(s => s.id === currentSceneId);
  const currentVersion = currentScene?.versions[currentScene.currentVersionIndex];

  useEffect(() => {
    if (currentVersion?.videoBlob) {
      const generator = new SegmentThumbnailGenerator();
      generator.generateThumbnails(
        currentVersion.videoBlob,
        parseInt(currentScene!.parameters.seconds),
        1  // 1 thumbnail per second
      ).then(setThumbnails);
    }
  }, [currentVersion?.videoBlob]);

  if (!currentVersion) return null;

  return (
    <div className="timeline-view">
      <div className="timeline-view__track">
        {thumbnails.map((thumbnail, index) => (
          <TimelineThumbnail
            key={index}
            thumbnail={thumbnail}
            isActive={Math.floor(currentTime) === Math.floor(thumbnail.timestamp)}
            onClick={() => {
              // Seek video to this timestamp
              const videoEl = document.querySelector('video');
              if (videoEl) videoEl.currentTime = thumbnail.timestamp;
            }}
          />
        ))}
      </div>

      <div
        className="timeline-view__playhead"
        style={{
          left: `${(currentTime / parseInt(currentScene!.parameters.seconds)) * 100}%`
        }}
      />
    </div>
  );
};
```

**Task 4.6**: Create TimelineThumbnail component

Create `src/components/scene-builder/TimelineThumbnail.tsx`:

```typescript
import React from 'react';

interface TimelineThumbnailProps {
  thumbnail: {
    timestamp: number;
    url: string;
  };
  isActive: boolean;
  onClick: () => void;
}

export const TimelineThumbnail: React.FC<TimelineThumbnailProps> = ({
  thumbnail,
  isActive,
  onClick
}) => {
  return (
    <div
      className={`timeline-thumbnail ${isActive ? 'timeline-thumbnail--active' : ''}`}
      onClick={onClick}
    >
      <img
        src={thumbnail.url}
        alt={`${thumbnail.timestamp}s`}
        className="timeline-thumbnail__image"
      />
      <span className="timeline-thumbnail__time">
        {thumbnail.timestamp.toFixed(1)}s
      </span>
    </div>
  );
};
```

