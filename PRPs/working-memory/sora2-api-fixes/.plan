### Implementation Patterns & Key Details

```typescript
// PATTERN: getModelForSize helper (add to src/types/index.ts)
// All four Pro sizes require sora-2-pro:
// '1792x1024', '1024x1792' (PromptForm.tsx Pro options)
// '1920x1080', '1080x1920' (PromptEditor.tsx Full HD options)
export const PRO_SIZES = ['1792x1024', '1024x1792', '1920x1080', '1080x1920'] as const;
export const VALID_SECONDS = ['4', '8', '12', '16', '20'] as const;

export function getModelForSize(size: string): 'sora-2' | 'sora-2-pro' {
  return PRO_SIZES.includes(size as typeof PRO_SIZES[number]) ? 'sora-2-pro' : 'sora-2';
}

// PATTERN: Timeout in pollUntilComplete (openaiService.ts)
async pollUntilComplete(videoId, apiKey, onProgress) {
  const POLL_TIMEOUT_MS = 20 * 60 * 1000;
  const POLL_INTERVAL_MS = 10 * 1000;
  const startTime = Date.now();

  while (true) {
    const elapsed = Date.now() - startTime;
    if (elapsed > POLL_TIMEOUT_MS) {
      throw new Error(`Video generation timed out after 20 minutes. Job ID: ${videoId}`);
    }

    const job = await this.getVideoStatus(videoId, apiKey);
    console.log(`[Poll] ${videoId}: status=${job.status}, progress=${job.progress ?? '?'}%, elapsed=${Math.round(elapsed/1000)}s`);

    if (onProgress && job.progress !== undefined) onProgress(job.progress);
    if (job.status === 'completed') return job;
    if (job.status === 'failed') throw new Error(job.error?.message || 'Video generation failed');

    await new Promise(resolve => setTimeout(resolve, POLL_INTERVAL_MS));
  }
}

// PATTERN: Server-side validation in proxy-create-video.ts
const validSeconds = ['4', '8', '12', '16', '20'];
if (!validSeconds.includes(secondsStr)) {
  return new Response(JSON.stringify({
    error: `Invalid seconds value: must be one of ${validSeconds.join(', ')}, got '${secondsStr}'`
  }), { status: 400, headers: { 'Content-Type': 'application/json' } });
}

// Pro-only sizes require sora-2-pro model
const proSizes = ['1792x1024', '1024x1792', '1920x1080', '1080x1920'];
if (proSizes.includes(String(size)) && model !== 'sora-2-pro') {
  return new Response(JSON.stringify({
    error: `Pro resolution (${size}) requires model 'sora-2-pro', got '${model}'`
  }), { status: 400, headers: { 'Content-Type': 'application/json' } });
}

// PATTERN: Segment error recovery in App.tsx
let hasFailures = false;
const successfulBlobs: Blob[] = [];

for (let i = 0; i < numSegments; i++) {
  try {
    // ... generate segment
    successfulBlobs.push(blob);
  } catch (segmentError: any) {
    console.error(`[Segment ${i+1}] FAILED:`, segmentError.message);
    segment.status = 'failed';
    segment.error = segmentError.message;
    setSegments([...segmentList]);
    hasFailures = true;
    // Continue loop — don't throw
  }
}

if (successfulBlobs.length === 0) {
  throw new Error('All segments failed to generate. Please try again.');
}
// Concatenate only successful blobs
```

