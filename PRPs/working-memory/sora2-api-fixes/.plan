curl -X POST http://localhost:3000/api/proxy-create-video \
  -H "Content-Type: application/json" \
  -d '{"apiKey":"sk-test","prompt":"test","seconds":"15","size":"1280x720","model":"sora-2"}' \
  | jq .
# Expected: { "error": "Invalid seconds value: must be one of 4, 8, 12, 16, 20..." }

# Verify proxy rejects HD with wrong model
curl -X POST http://localhost:3000/api/proxy-create-video \
  -H "Content-Type: application/json" \
  -d '{"apiKey":"sk-test","prompt":"test","seconds":"8","size":"1920x1080","model":"sora-2"}' \
  | jq .
# Expected: { "error": "HD resolution (1920x1080) requires model 'sora-2-pro'..." }

# Verify proxy allows HD with correct model
curl -X POST http://localhost:3000/api/proxy-create-video \
  -H "Content-Type: application/json" \
  -d '{"apiKey":"sk-test","prompt":"test","seconds":"8","size":"1920x1080","model":"sora-2-pro"}' \
  | jq .
# Expected: OpenAI API response (auth error OK, not proxy validation error)
```

